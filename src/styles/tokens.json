{
  "$schema": "https://schemas.orbit-os.dev/tokens-v1.json",
  "$comment": "Orbit OS — Single source of truth for all design tokens. This file mirrors src/styles/tokens.css. When editing, update both (or run scripts/sync-tokens.ts when it exists). Exported for Figma / Tokens Studio / Style Dictionary sync.",
  "version": "0.1.0",
  "name": "orbit-os-default",
  "color": {
    "brand": {
      "primary":      { "value": "#8b5cf6", "comment": "violet-500 — buttons, active nav, highlights" },
      "primaryHover": { "value": "#7c3aed", "comment": "violet-600 — hover on primary" },
      "primaryFg":    { "value": "#ffffff" },
      "ring":         { "value": "#8b5cf6" }
    },
    "surface": {
      "background":    { "value": "#f3f4f6", "dark": "#0f172a" },
      "foreground":    { "value": "#1f2937", "dark": "#f8fafc" },
      "card":          { "value": "#ffffff", "dark": "#1e293b" },
      "cardFg":        { "value": "#1f2937", "dark": "#f8fafc" },
      "popover":       { "value": "#ffffff", "dark": "#1e293b" },
      "popoverFg":     { "value": "#1f2937", "dark": "#f8fafc" },
      "border":        { "value": "#e5e7eb", "dark": "#334155" },
      "input":         { "value": "#e5e7eb", "dark": "#334155" },
      "secondary":     { "value": "#f1f5f9", "dark": "#334155" },
      "secondaryFg":   { "value": "#1f2937", "dark": "#f8fafc" },
      "muted":         { "value": "#f3f4f6", "dark": "#334155" },
      "mutedFg":       { "value": "#6b7280", "dark": "#94a3b8" },
      "accent":        { "value": "#f3f4f6", "dark": "#334155" },
      "accentFg":      { "value": "#1f2937", "dark": "#f8fafc" }
    },
    "status": {
      "success": {
        "DEFAULT": { "value": "#10b981", "comment": "emerald-500" },
        "100":     { "value": "#d1fae5", "dark": "rgba(6, 78, 59, 0.3)" },
        "500":     { "value": "#10b981" },
        "700":     { "value": "#047857", "dark": "#34d399" },
        "fg":      { "value": "#ffffff" }
      },
      "warning": {
        "DEFAULT": { "value": "#f59e0b", "comment": "amber-500" },
        "100":     { "value": "#fef3c7", "dark": "rgba(120, 53, 15, 0.3)" },
        "500":     { "value": "#f59e0b" },
        "700":     { "value": "#b45309", "dark": "#fbbf24" },
        "fg":      { "value": "#ffffff" }
      },
      "danger": {
        "DEFAULT": { "value": "#ef4444", "comment": "red-500 — also used as destructive" },
        "100":     { "value": "#fee2e2", "dark": "rgba(127, 29, 29, 0.3)" },
        "500":     { "value": "#ef4444" },
        "700":     { "value": "#b91c1c", "dark": "#f87171" },
        "fg":      { "value": "#ffffff", "dark": "#f8fafc" }
      },
      "info": {
        "DEFAULT": { "value": "#3b82f6", "comment": "blue-500" },
        "100":     { "value": "#dbeafe", "dark": "rgba(30, 58, 138, 0.3)" },
        "500":     { "value": "#3b82f6" },
        "700":     { "value": "#1d4ed8", "dark": "#60a5fa" },
        "fg":      { "value": "#ffffff" }
      }
    }
  },
  "gradient": {
    "$comment": "KPI card gradients — use via .bg-kpi-<name> utilities. Add a new gradient here AND in tokens.css to expose it.",
    "kpi": {
      "arrivals":   { "from": "#ec4899", "to": "#e11d48", "comment": "pink-500 → rose-600" },
      "inHouse":    { "from": "#8b5cf6", "to": "#9333ea", "comment": "violet-500 → purple-600" },
      "departures": { "from": "#10b981", "to": "#16a34a", "comment": "emerald-500 → green-600" },
      "revenue":    { "from": "#f59e0b", "to": "#ca8a04", "comment": "amber-500 → yellow-600" },
      "occupancy":  { "from": "#3b82f6", "to": "#0891b2", "comment": "blue-500 → cyan-600" },
      "adrRevpar":  { "from": "#6366f1", "to": "#7c3aed", "comment": "indigo-500 → violet-600" }
    }
  },
  "radius": {
    "none": { "value": "0px" },
    "sm":   { "value": "0.25rem" },
    "md":   { "value": "0.5rem" },
    "lg":   { "value": "0.75rem" },
    "xl":   { "value": "1rem", "comment": "--radius default" },
    "2xl":  { "value": "1.5rem", "comment": "default card radius" },
    "full": { "value": "9999px" }
  },
  "shadow": {
    "none": { "value": "none" },
    "sm":   { "value": "0 1px 2px 0 rgb(0 0 0 / 0.05)" },
    "md":   { "value": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)" },
    "lg":   { "value": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)" },
    "xl":   { "value": "0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1)" }
  },
  "typography": {
    "fontFamily": {
      "sans":   { "value": "'Inter', system-ui, -apple-system, sans-serif" },
      "display":{ "value": "'DM Sans', 'Inter', system-ui, sans-serif" },
      "mono":   { "value": "ui-monospace, 'SF Mono', Menlo, monospace" }
    },
    "fontSize": {
      "xs":  { "value": "0.75rem",  "lineHeight": "1rem" },
      "sm":  { "value": "0.875rem", "lineHeight": "1.25rem" },
      "md":  { "value": "1rem",     "lineHeight": "1.5rem" },
      "lg":  { "value": "1.125rem", "lineHeight": "1.75rem" },
      "xl":  { "value": "1.25rem",  "lineHeight": "1.75rem" },
      "2xl": { "value": "1.5rem",   "lineHeight": "2rem" },
      "3xl": { "value": "1.875rem", "lineHeight": "2.25rem" }
    },
    "fontWeight": {
      "normal":    { "value": "400" },
      "medium":    { "value": "500" },
      "semibold":  { "value": "600" },
      "bold":      { "value": "700" }
    }
  },
  "motion": {
    "duration": {
      "instant": { "value": "0ms" },
      "fast":    { "value": "120ms" },
      "base":    { "value": "200ms" },
      "slow":    { "value": "320ms" }
    },
    "easing": {
      "standard": { "value": "cubic-bezier(0.2, 0, 0, 1)" },
      "decelerate":{ "value": "cubic-bezier(0, 0, 0, 1)" },
      "accelerate":{ "value": "cubic-bezier(0.3, 0, 1, 1)" }
    }
  },
  "z": {
    "base":    { "value": "0" },
    "sticky":  { "value": "10" },
    "dropdown":{ "value": "20" },
    "overlay": { "value": "40" },
    "modal":   { "value": "50" },
    "toast":   { "value": "60" }
  }
}
